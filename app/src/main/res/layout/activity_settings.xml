<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/metro_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="‹ 返回"
            android:textColor="#FF4FA3E3"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="设置"
            android:textColor="#FFFFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="FindYouDevice-old v1.0.0"
            android:textColor="@color/metro_text_secondary"
            android:textSize="13sp" />

        <!-- 关于（3A 先行版；服务与主机配置将于后续补充） -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="关于"
            android:textColor="@color/metro_text_secondary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/metro_bg_soft"
            android:orientation="vertical"
            android:padding="6dp">

            <TextView
                android:id="@+id/rowProject"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/metro_row"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="项目地址（点击打开）"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/rowQq"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/metro_row"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="联系作者 · QQ 3891605032（点击复制）"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/rowMail"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/metro_row"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="联系作者 · fxxkhw676767@outlook.com"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp" />

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
