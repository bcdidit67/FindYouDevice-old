<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#00000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="24dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FindYouDevice-old v1.0.0"
            android:textColor="#FFFFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvBase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="3dp"
            android:text="基于 FindYouDevice v1.1.1 开发"
            android:textColor="#FFAAAAAA"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#33FFFFFF" />

        <TextView
            android:id="@+id/rowProject"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="start|center_vertical"
            android:text="项目地址"
            android:textColor="#FFEDEDED"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/rowQq"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="start|center_vertical"
            android:text="联系作者 · QQ 3891605032（点击复制）"
            android:textColor="#FFEDEDED"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/rowMail"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="start|center_vertical"
            android:text="fxxkhw676767@outlook.com"
            android:textColor="#FFEDEDED"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="此版本使用 WP10 平面设计，最低兼容 Android 5.0；\n此版本可能更新较慢，详见仓库说明。"
            android:textColor="#FF777777"
            android:textSize="12sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
