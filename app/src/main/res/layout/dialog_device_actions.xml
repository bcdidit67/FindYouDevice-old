<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/metro_bg_soft"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/tvDlgTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF4FA3E3"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDlgSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/metro_text_secondary"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="6dp"
            android:background="#FF333333" />

        <TextView
            android:id="@+id/rowFind"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/metro_row"
            android:gravity="center_vertical"
            android:text="查找设备"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rowStop"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/metro_row"
            android:gravity="center_vertical"
            android:text="停止查找"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="锁定查找（持续响铃直到手动停止）"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/swLockFind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:id="@+id/rowEdit"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/metro_row"
            android:gravity="center_vertical"
            android:text="编辑别名"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rowDelete"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/metro_row"
            android:gravity="center_vertical"
            android:text="删除设备"
            android:textColor="#FFFF6B6B"
            android:textSize="16sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:background="#FF333333" />

        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/metro_row"
            android:gravity="center"
            android:text="取消"
            android:textColor="@color/metro_text_secondary"
            android:textSize="15sp" />

    </LinearLayout>
</FrameLayout>
