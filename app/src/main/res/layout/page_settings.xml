<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#00000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="4dp"
        android:paddingStart="16dp"
        android:text="背景来源"
        android:textColor="#FF888888"
        android:textSize="13sp" />
        <TextView
            android:id="@+id/rowBgSystem"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/metro_row"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="跟随系统壁纸"
            android:textColor="#FFEDEDED"
            android:textSize="17sp" />
        <TextView
            android:id="@+id/rowBgSolid"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/metro_row"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="纯色背景"
            android:textColor="#FFEDEDED"
            android:textSize="17sp" />
        <TextView
            android:id="@+id/rowBgImage"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/metro_row"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="自定义图片（从相册选择）"
            android:textColor="#FFEDEDED"
            android:textSize="17sp" />
    <TextView
        android:id="@+id/tvBgCurrent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:text="当前：跟随系统壁纸"
        android:textColor="#FF777777"
        android:textSize="12sp" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="4dp"
        android:paddingStart="16dp"
        android:text="强调色"
        android:textColor="#FF888888"
        android:textSize="13sp" />
        <TextView
            android:id="@+id/rowHue"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/metro_row"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="选择强调色"
            android:textColor="#FF4FA3E3"
            android:textSize="17sp" />
    <TextView
        android:id="@+id/tvHue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:text="当前：亮蓝"
        android:textColor="#FF777777"
        android:textSize="12sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="62dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="动态取色"
                    android:textColor="#FFEDEDED"
                    android:textSize="17sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="从壁纸 / 图片自动提取主色"
                    android:textColor="#FF888888"
                    android:textSize="12sp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swDynamic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="62dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="半透明磁贴"
                    android:textColor="#FFEDEDED"
                    android:textSize="17sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="磁贴透出壁纸"
                    android:textColor="#FF888888"
                    android:textSize="12sp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swTransparent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp" />
        </LinearLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="4dp"
        android:paddingStart="16dp"
        android:text="服务自动控制"
        android:textColor="#FF888888"
        android:textSize="13sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="62dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="连接 WiFi 时自动开启"
                    android:textColor="#FFEDEDED"
                    android:textSize="17sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="需曾手动开启过服务"
                    android:textColor="#FF888888"
                    android:textSize="12sp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swAutoWifi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="62dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="连接移动流量时自动关闭"
                    android:textColor="#FFEDEDED"
                    android:textSize="17sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text=""
                    android:textColor="#FF888888"
                    android:textSize="12sp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swAutoCell"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="62dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="连接热点 / 计量网络时自动关闭"
                    android:textColor="#FFEDEDED"
                    android:textSize="17sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text=""
                    android:textColor="#FF888888"
                    android:textSize="12sp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swAutoMetered"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp" />
        </LinearLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="4dp"
        android:paddingStart="16dp"
        android:text="主机配置"
        android:textColor="#FF888888"
        android:textSize="13sp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Web 控制台密码（留空清除）"
            android:inputType="textPassword"
            android:textColor="#FFEDEDED"
            android:textColorHint="#FF777777"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnSavePwd"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/metro_row"
            android:gravity="start|center_vertical"
            android:text="保存密码"
            android:textColor="#FF4FA3E3"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etFlash"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="闪光灯 sysfs 节点（root）"
            android:inputType="text"
            android:textColor="#FFEDEDED"
            android:textColorHint="#FF777777"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnSaveFlash"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/metro_row"
            android:gravity="start|center_vertical"
            android:text="保存节点"
            android:textColor="#FF4FA3E3"
            android:textSize="16sp" />
    </LinearLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="4dp"
        android:paddingStart="16dp"
        android:text="联系与项目"
        android:textColor="#FF888888"
        android:textSize="13sp" />
        <TextView
            android:id="@+id/rowProjectSet"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/metro_row"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="项目地址（点击打开）"
            android:textColor="#FFEDEDED"
            android:textSize="17sp" />
        <TextView
            android:id="@+id/rowQqSet"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/metro_row"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="联系作者 · QQ（点击复制）"
            android:textColor="#FFEDEDED"
            android:textSize="17sp" />
        <TextView
            android:id="@+id/rowMailSet"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/metro_row"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="fxxkhw676767@outlook.com"
            android:textColor="#FFEDEDED"
            android:textSize="17sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
