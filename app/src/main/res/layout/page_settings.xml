<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#00000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:paddingStart="14dp"
        android:text="主题"
        android:textColor="#FF888888"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/rowBgSystem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/metro_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="背景：跟随系统壁纸"
                android:textColor="#FFEDEDED"
                android:textSize="16sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/rowBgSolid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/metro_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="背景：纯色（选择强调色）"
                android:textColor="#FFEDEDED"
                android:textSize="16sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/rowBgImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/metro_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="背景：自定义图片（从相册选择）"
                android:textColor="#FFEDEDED"
                android:textSize="16sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/rowHue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/metro_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="强调色"
                android:textColor="#FFEDEDED"
                android:textSize="16sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/tvHue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="14dp"
            android:paddingBottom="6dp"
            android:text="当前强调色：亮蓝"
            android:textColor="#FF888888"
            android:textSize="12sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="60dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="动态取色"
                    android:textColor="#FFEDEDED"
                    android:textSize="16sp" />
                
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="从壁纸 / 图片自动提取主色"
                android:textColor="#FF888888"
                android:textSize="12sp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:track="@drawable/wp_switch_track"
                android:thumb="@drawable/wp_switch_thumb"
                android:id="@+id/swDynamic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="60dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="半透明磁贴"
                    android:textColor="#FFEDEDED"
                    android:textSize="16sp" />
                
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="磁贴明显透出壁纸"
                android:textColor="#FF888888"
                android:textSize="12sp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:track="@drawable/wp_switch_track"
                android:thumb="@drawable/wp_switch_thumb"
                android:id="@+id/swTransparent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:paddingStart="14dp"
        android:text="服务自动控制"
        android:textColor="#FF888888"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="60dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="连接 WiFi 时自动开启"
                    android:textColor="#FFEDEDED"
                    android:textSize="16sp" />
                
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:track="@drawable/wp_switch_track"
                android:thumb="@drawable/wp_switch_thumb"
                android:id="@+id/swAutoWifi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="60dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="连接移动流量时自动关闭"
                    android:textColor="#FFEDEDED"
                    android:textSize="16sp" />
                
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:track="@drawable/wp_switch_track"
                android:thumb="@drawable/wp_switch_thumb"
                android:id="@+id/swAutoCell"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="60dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="连接热点 / 计量网络时自动关闭"
                    android:textColor="#FFEDEDED"
                    android:textSize="16sp" />
                
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:track="@drawable/wp_switch_track"
                android:thumb="@drawable/wp_switch_thumb"
                android:id="@+id/swAutoMetered"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:paddingStart="14dp"
        android:text="主机配置"
        android:textColor="#FF888888"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="Web 控制台密码（留空清除）"
            android:inputType="textPassword"
            android:textColor="#FFEDEDED"
            android:textColorHint="#FF777777"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnSavePwd"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/metro_row"
            android:gravity="start|center_vertical"
            android:text="保存密码"
            android:textColor="#FF4FA3E3"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etFlash"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="闪光灯 sysfs 节点（root）"
            android:inputType="text"
            android:textColor="#FFEDEDED"
            android:textColorHint="#FF777777"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnSaveFlash"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/metro_row"
            android:gravity="start|center_vertical"
            android:text="保存节点"
            android:textColor="#FF4FA3E3"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvBgMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="当前：系统壁纸"
            android:textColor="#FF777777"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="FindYouDevice-old v1.0.0"
            android:textColor="#FF777777"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:paddingStart="14dp"
        android:text="联系与项目"
        android:textColor="#FF888888"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/rowProjectSet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/metro_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="项目地址（点击打开）"
                android:textColor="#FFEDEDED"
                android:textSize="16sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/rowQqSet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/metro_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="联系作者 · QQ（点击复制）3891605032"
                android:textColor="#FFEDEDED"
                android:textSize="16sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/rowMailSet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/metro_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="fxxkhw676767@outlook.com"
                android:textColor="#FFEDEDED"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
