<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Metro 主题：纯黑背景、直角、无阴影 -->
    <style name="Theme.FindYouDevice.Old" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/metro_bg</item>
        <item name="android:statusBarColor">@color/metro_bg</item>
        <item name="android:colorBackground">@color/metro_bg</item>
        <item name="colorPrimary">@color/metro_tile_blue</item>
        <item name="colorPrimaryDark">@color/metro_tile_blue_pressed</item>
        <item name="colorAccent">@color/metro_tile_blue</item>
        <item name="android:textColorPrimary">@color/metro_text_primary</item>
        <item name="android:textColorSecondary">@color/metro_text_secondary</item>
    </style>

    <!-- Metro 行点击反馈（替代 ?attr/selectableItemBackground，避免主题属性解析失败） -->
    <style name="Metro.Row" parent="">
        <item name="android:background">@drawable/metro_row</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- 磁贴基础样式：纯色、零阴影、零圆角、无状态动画 -->
    <style name="Metro.Tile" parent="">
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:background">@color/metro_tile_blue</item>
        <item name="android:textColor">@color/metro_text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">start|bottom</item>
    </style>
</resources>
